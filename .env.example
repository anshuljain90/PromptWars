# Copy to .env (gitignored) and fill values. In production these come from
# Google Secret Manager — never commit real values.

# ── Backend (FastAPI) ────────────────────────────────────────────────────────

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to call (Flash is fast + cheap, Pro is higher quality)
GEMINI_MODEL=gemini-2.0-flash-exp

# Google Maps API key with Places API + Distance Matrix API enabled
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Firebase project ID (find at console.firebase.google.com → Project Settings)
FIREBASE_PROJECT_ID=

# Path to Firebase Admin service account JSON (local dev only).
# In Cloud Run, leave blank — Application Default Credentials will be used.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated list of allowed origins for CORS.
# In dev: http://localhost:3000
# In prod: https://<your-firebase-hosting-domain>
ALLOWED_ORIGINS=http://localhost:3000

# Places client backend: "live" hits Maps API, "fixture" reads local JSON files.
# Use "fixture" for offline tests; "live" for production demo.
PLACES_BACKEND=live

# Optional cache TTL in seconds for Gemini and Places responses.
CACHE_TTL_SECONDS=3600

# ── Frontend (Next.js) — must be NEXT_PUBLIC_ prefixed to reach the browser ──

# Firebase Web SDK config (Project Settings → General → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Same Maps key as backend, but restricted to HTTP referrers for the frontend
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend base URL (Cloud Run service URL in prod; localhost in dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
